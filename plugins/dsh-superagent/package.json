    "@types/proper-lockfile": "4.1.4",
    "@types/react": "18.3.28",
    "jsdom": "29.1.1",
    "msp-ts": "file:vendor/msp-ts",
    "react": "18.3.1",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "vitest": "4.1.8",
    "@deepseek-ai/dsh-skill": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-attachment": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-alpha.2",
    "react-dom": "18.3.1",
